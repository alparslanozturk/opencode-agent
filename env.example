# opencode paketi — ortam degiskenleri
# Kullanim:  cp env.example env   →  sonra asagidaki 3 satiri doldur.
# Not: 'env' dosyasi bilerek git'e GIRMEZ (URL + anahtar repoda durmasin).

# 1) Kurumun OpenAI uyumlu koku. /v1 ile biter; SONDA '/' OLMAZ.
KURUM_URL=http://KURUM_ENDPOINT:PORT/v1

# 2) API anahtari (endpoint anahtar istemiyorsa "yok" yaz, bos birakma)
KURUM_KEY=DEGISTIR

# 3) Model kimligi (isteklerde giden "model" alani)
MODEL_ID=/data/models--Qwen--Qwen36-35B-A3B-FP8
